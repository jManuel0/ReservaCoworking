{
  "info": {
    "name": "ReservasCoworking",
    "description": "Colección completa de endpoints para el sistema de reservas de coworking.\n\n⚠️ NOTA: Las fechas en los requests usan el rango 2026-10-05 a 2026-10-09.\nSi han pasado más de 5 días desde el 2026-10-04, actualiza las fechas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Recursos",
      "item": [
        {
          "name": "1. Crear Recurso - Escritorio Test",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/recursos", "host": ["{{baseUrl}}"], "path": ["api", "recursos"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Escritorio Test\",\n  \"tipo\": \"ESCRITORIO\",\n  \"capacidad\": 1,\n  \"precioHora\": 8000,\n  \"tieneProyector\": false\n}"
            }
          }
        },
        {
          "name": "2. Crear Recurso - Sala Test",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/recursos", "host": ["{{baseUrl}}"], "path": ["api", "recursos"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sala Test\",\n  \"tipo\": \"SALA_REUNION\",\n  \"capacidad\": 8,\n  \"precioHora\": 35000,\n  \"tieneProyector\": true\n}"
            }
          }
        },
        {
          "name": "3. Listar Recursos",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/recursos", "host": ["{{baseUrl}}"], "path": ["api", "recursos"]}
          }
        },
        {
          "name": "4. Obtener Recurso por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/recursos/1", "host": ["{{baseUrl}}"], "path": ["api", "recursos", "1"]}
          }
        },
        {
          "name": "5. Actualizar Recurso",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/recursos/1", "host": ["{{baseUrl}}"], "path": ["api", "recursos", "1"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Escritorio A1 Actualizado\",\n  \"tipo\": \"ESCRITORIO\",\n  \"capacidad\": 1,\n  \"precioHora\": 9000,\n  \"tieneProyector\": false\n}"
            }
          }
        },
        {
          "name": "15. Recursos Disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/recursos/disponibles?inicio=2026-10-07T09:00:00&fin=2026-10-07T11:00:00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recursos", "disponibles"],
              "query": [
                {"key": "inicio", "value": "2026-10-07T09:00:00"},
                {"key": "fin", "value": "2026-10-07T11:00:00"}
              ]
            }
          }
        },
        {
          "name": "23. Eliminar Recurso",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/recursos/2", "host": ["{{baseUrl}}"], "path": ["api", "recursos", "2"]}
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "6. Crear Cliente - Estándar",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"María López\",\n  \"email\": \"maria.lopez@test.com\",\n  \"tipo\": \"ESTANDAR\",\n  \"horasMembresia\": 0\n}"
            }
          }
        },
        {
          "name": "7. Crear Cliente - VIP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"José Ramírez\",\n  \"email\": \"jose.ramirez@test.com\",\n  \"tipo\": \"VIP\",\n  \"horasMembresia\": 10\n}"
            }
          }
        },
        {
          "name": "8. Listar Clientes",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"]}
          }
        },
        {
          "name": "9. Obtener Cliente por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/clientes/1", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "1"]}
          }
        },
        {
          "name": "10. Actualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/clientes/1", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "1"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura Gómez Actualizada\",\n  \"email\": \"laura.gomez@email.com\",\n  \"tipo\": \"VIP\",\n  \"horasMembresia\": 5\n}"
            }
          }
        },
        {
          "name": "14. Historial Reservas del Cliente",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/clientes/1/reservas", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "1", "reservas"]}
          }
        },
        {
          "name": "24. Eliminar Cliente",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/api/clientes/2", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "2"]}
          }
        }
      ]
    },
    {
      "name": "Reservas",
      "item": [
        {
          "name": "11. Crear Reserva",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"recursoId\": 3,\n  \"inicio\": \"2026-10-06T09:00:00\",\n  \"fin\": \"2026-10-06T11:00:00\"\n}"
            }
          }
        },
        {
          "name": "12. Listar Reservas",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]}
          }
        },
        {
          "name": "13. Obtener Reserva por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/reservas/1", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1"]}
          }
        },
        {
          "name": "16. Cancelar Reserva",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/reservas/1/cancelar", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1", "cancelar"]}
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "17. Reporte Ocupación",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/reportes/ocupacion", "host": ["{{baseUrl}}"], "path": ["api", "reportes", "ocupacion"]}
          }
        }
      ]
    },
    {
      "name": "Casos de Error",
      "item": [
        {
          "name": "18. [ERROR] Solapamiento - Mismo recurso mismo horario",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"recursoId\": 3,\n  \"inicio\": \"2026-10-08T09:00:00\",\n  \"fin\": \"2026-10-08T11:00:00\"\n}"
            },
            "description": "Intenta crear una reserva que solaparía con otra existente. Espera HTTP 409 Conflict."
          }
        },
        {
          "name": "19. [ERROR] Fuera de horario - Reserva a las 5am",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"recursoId\": 3,\n  \"inicio\": \"2026-10-09T05:00:00\",\n  \"fin\": \"2026-10-09T07:00:00\"\n}"
            },
            "description": "Reserva fuera del horario permitido (7:00-21:00). Espera HTTP 400 Bad Request."
          }
        },
        {
          "name": "20. [ERROR] Email repetido",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro Laura\",\n  \"email\": \"laura.gomez@email.com\",\n  \"tipo\": \"ESTANDAR\",\n  \"horasMembresia\": 0\n}"
            },
            "description": "Intenta registrar un cliente con email ya existente. Espera HTTP 409 Conflict."
          }
        },
        {
          "name": "21. [ERROR] ID inexistente",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/recursos/9999", "host": ["{{baseUrl}}"], "path": ["api", "recursos", "9999"]},
            "description": "Busca un recurso que no existe. Espera HTTP 404 Not Found."
          }
        },
        {
          "name": "22. [ERROR] Cancelar reserva ya cancelada",
          "request": {
            "method": "PATCH",
            "url": {"raw": "{{baseUrl}}/api/reservas/1/cancelar", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1", "cancelar"]},
            "description": "Intenta cancelar una reserva que ya fue cancelada. Espera HTTP 409 Conflict."
          }
        }
      ]
    }
  ]
}
